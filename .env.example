# Copia este archivo como .env.local y llena los valores de tu proyecto de Supabase
# (Supabase → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# URL pública de la app (en Vercel pon tu dominio, ej. https://expodiseno.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Iniciar sesión con Google vía Firebase (Firebase → Configuración del proyecto → Tus apps → Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Tarea diaria y resumen por correo (solo en Vercel; opcional) ---
# Texto largo al azar que inventes tú; Vercel lo usa para autorizar la tarea diaria.
CRON_SECRET=
# Supabase → Project Settings → API Keys → "service_role" / secret key. Nunca la publiques.
SUPABASE_SERVICE_ROLE_KEY=
# Cuenta de Gmail que envía los correos y su contraseña de aplicación (16 letras).
GMAIL_USER=
GMAIL_APP_PASSWORD=
